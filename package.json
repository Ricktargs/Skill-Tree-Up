{
  "name": "skill-tree-rpg",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "nanquim": "node scripts/build-nanquim.mjs",
    "app": "vite build && electron .",
    "app:instalador": "vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "build": "^0.1.4",
    "canvas-confetti": "^1.9.4",
    "emoji-picker-react": "^4.22.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "run": "^2.1.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "description": "ORBE-G — Organização, Rotina, Base, Evolução e Gamificação",
  "author": "ORBE-G",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.orbeg.app",
    "productName": "ORBE-G",
    "copyright": "ORBE-G",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ORBE-G",
      "installerIcon": "public/favicon.ico",
      "uninstallerIcon": "public/favicon.ico",
      "artifactName": "ORBE-G-Instalador.${ext}"
    }
  }
}
