{
  "name": "skill-tree-rpg",
  "private": true,
  "version": "2.0.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "nanquim": "node scripts/build-nanquim.mjs",
    "app": "vite build && electron .",
    "app:instalador": "vite build && electron-builder --win nsis --publish never",
    "app:mac": "vite build && electron-builder --mac dmg --universal --publish never",
    "android:sync": "vite build && cap sync android"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "build": "^0.1.4",
    "canvas-confetti": "^1.9.4",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "emoji-picker-react": "^4.22.3",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "run": "^2.1.7",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "description": "ORBE-G — Organização, Rotina, Base, Evolução e Gamificação",
  "author": "ORBE-G",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.orbeg.app",
    "productName": "ORBE-G",
    "copyright": "ORBE-G",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/favicon.ico",
      "artifactName": "ORBE-G-Instalador.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ORBE-G",
      "installerIcon": "public/favicon.ico",
      "uninstallerIcon": "public/favicon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Ricktargs",
        "repo": "Skill-Tree-Up",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "ORBE-G-Mac.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O ORBE-G usa o microfone para gravar áudios nos flashcards."
      }
    },
    "dmg": {
      "title": "ORBE-G"
    }
  }
}
